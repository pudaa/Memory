<?xml version="1.0" encoding="utf-8"?>
<!-- 点按对焦提示圈：四角括号 + 中心点，白色描边 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="80dp"
    android:height="80dp"
    android:viewportWidth="80"
    android:viewportHeight="80">

    <!-- 左上角 -->
    <path
        android:pathData="M6,22 L6,6 L22,6"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent" />
    <!-- 右上角 -->
    <path
        android:pathData="M58,6 L74,6 L74,22"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent" />
    <!-- 左下角 -->
    <path
        android:pathData="M22,74 L6,74 L6,58"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent" />
    <!-- 右下角 -->
    <path
        android:pathData="M74,58 L74,74 L58,74"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent" />
    <!-- 中心点 -->
    <path
        android:pathData="M40,40 m-2.5,0 a2.5,2.5 0 1,1 5,0 a2.5,2.5 0 1,1 -5,0"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="0.1"
        android:fillColor="#FFFFFF" />
</vector>
