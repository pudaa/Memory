<?xml version="1.0" encoding="utf-8"?>
<!-- 顶部渐变遮罩：上方深色渐变到透明，提升顶栏按钮在取景画面上的辨识度 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#99000000"
        android:endColor="#00000000" />
</shape>
