<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/box_shadow_border" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <stroke android:width="6dp" android:color="@color/box_shadow_border" />
            <solid android:color="@color/box_shadow_fill" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</layer-list>