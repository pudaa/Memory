<?xml version="1.0" encoding="utf-8"?>
<!-- 学习概览 Tab 内容 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scrollbars="none"
    android:background="@color/theme_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- ── 学习概览 ── -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginTop="8dp" android:layout_marginBottom="8dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="学习概览" android:textSize="17sp" android:textStyle="bold"
                android:textColor="@color/theme_text_primary" />
            <View android:layout_width="0dp" android:layout_height="1dp"
                android:layout_weight="1" android:layout_marginStart="12dp" android:layout_marginEnd="4dp"
                android:background="@drawable/section_divider_line" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:baselineAligned="false">
            <include layout="@layout/item_eval_card" android:id="@+id/card_days" />
            <include layout="@layout/item_eval_card" android:id="@+id/card_streak" />
            <include layout="@layout/item_eval_card" android:id="@+id/card_words" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:baselineAligned="false"
            android:layout_marginTop="8dp">
            <include layout="@layout/item_eval_card" android:id="@+id/card_mastery" />
            <include layout="@layout/item_eval_card" android:id="@+id/card_today_done" />
            <include layout="@layout/item_eval_card" android:id="@+id/card_today_due" />
        </LinearLayout>

        <!-- ── FSRS 记忆指标 ── -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginTop="20dp" android:layout_marginBottom="8dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="FSRS 记忆指标" android:textSize="17sp" android:textStyle="bold"
                android:textColor="@color/theme_text_primary" />
            <View android:layout_width="0dp" android:layout_height="1dp"
                android:layout_weight="1" android:layout_marginStart="12dp" android:layout_marginEnd="4dp"
                android:background="@drawable/section_divider_line" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/card_round_bg" android:elevation="1dp"
            android:orientation="vertical" android:padding="16dp"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:baselineAligned="false">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="8dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="可提取性" android:textSize="12sp" android:textColor="@color/theme_text_secondary" />
                    <TextView android:id="@+id/tv_avg_retrievability"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="--" android:textSize="20sp" android:textStyle="bold"
                        android:textColor="@color/theme_stress" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="8dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="稳定性" android:textSize="12sp" android:textColor="@color/theme_text_secondary" />
                    <TextView android:id="@+id/tv_avg_stability"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="--" android:textSize="20sp" android:textStyle="bold"
                        android:textColor="@color/theme_stress" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="8dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="难度" android:textSize="12sp" android:textColor="@color/theme_text_secondary" />
                    <TextView android:id="@+id/tv_avg_difficulty"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="--" android:textSize="20sp" android:textStyle="bold"
                        android:textColor="@color/theme_stress" />
                </LinearLayout>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/light_gray" android:layout_marginVertical="8dp" />

            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:baselineAligned="false">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="4dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="总复习" android:textSize="12sp" android:textColor="@color/theme_text_secondary" />
                    <TextView android:id="@+id/tv_total_reviews"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="--" android:textSize="16sp" android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="4dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="平均评分" android:textSize="12sp" android:textColor="@color/theme_text_secondary" />
                    <TextView android:id="@+id/tv_avg_score"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="--" android:textSize="16sp" android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="4dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="薄弱词" android:textSize="12sp" android:textColor="@color/theme_text_secondary" />
                    <TextView android:id="@+id/tv_weak_word_count"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="--" android:textSize="16sp" android:textStyle="bold"
                        android:textColor="@color/theme_error" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ── 掌握度分布 ── -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginTop="20dp" android:layout_marginBottom="8dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="掌握度分布" android:textSize="17sp" android:textStyle="bold"
                android:textColor="@color/theme_text_primary" />
            <View android:layout_width="0dp" android:layout_height="1dp"
                android:layout_weight="1" android:layout_marginStart="12dp" android:layout_marginEnd="4dp"
                android:background="@drawable/section_divider_line" />
        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent" android:layout_height="260dp"
            android:layout_marginBottom="8dp"
            app:cardElevation="1dp" app:cardCornerRadius="12dp"
            app:cardBackgroundColor="@color/card_background">

            <com.github.mikephil.charting.charts.PieChart
                android:id="@+id/mastery_pie_chart"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:padding="8dp" />
        </androidx.cardview.widget.CardView>

        <!-- ── 近7日趋势 ── -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginTop="12dp" android:layout_marginBottom="8dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="近7日学习趋势" android:textSize="17sp" android:textStyle="bold"
                android:textColor="@color/theme_text_primary" />
            <View android:layout_width="0dp" android:layout_height="1dp"
                android:layout_weight="1" android:layout_marginStart="12dp" android:layout_marginEnd="4dp"
                android:background="@drawable/section_divider_line" />
        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent" android:layout_height="240dp"
            android:layout_marginBottom="8dp"
            app:cardElevation="1dp" app:cardCornerRadius="12dp"
            app:cardBackgroundColor="@color/card_background">

            <com.github.mikephil.charting.charts.LineChart
                android:id="@+id/recent_7days_chart"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:padding="8dp" />
        </androidx.cardview.widget.CardView>

        <!-- ── AI 周报总结 ── -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginTop="12dp" android:layout_marginBottom="8dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="AI 周报总结" android:textSize="17sp" android:textStyle="bold"
                android:textColor="@color/theme_text_primary" />
            <View android:layout_width="0dp" android:layout_height="1dp"
                android:layout_weight="1" android:layout_marginStart="12dp" android:layout_marginEnd="4dp"
                android:background="@drawable/section_divider_line" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/card_round_bg" android:elevation="1dp"
            android:padding="16dp" android:layout_marginBottom="12dp">
            <TextView android:id="@+id/tv_ai_weekly_summary"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="加载中..." android:textSize="14sp"
                android:textColor="@color/theme_text_secondary"
                android:lineSpacingMultiplier="1.4" />
        </LinearLayout>

        <View android:layout_width="0dp" android:layout_height="20dp" />

    </LinearLayout>
</ScrollView>
