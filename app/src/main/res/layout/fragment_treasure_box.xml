<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
>
    <LinearLayout
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:background="@color/white"
        android:padding="8dp"
        android:elevation="4dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:visibility="invisible"
            android:orientation="horizontal"
            android:padding="4dp">

            <ImageButton
                android:id="@+id/btn_plan"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/program_revisions"
                android:background="@null"
                android:scaleType="centerInside"
                android:layout_gravity="center_vertical"
                android:textSize="14sp"
            />


        </LinearLayout>

        <TextView
                android:id="@+id/tv_day_count"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="百宝箱"
                android:layout_weight="1"
                android:gravity="center"
                android:layout_gravity="center"
                android:textSize="23sp"
                android:textStyle="bold"/>


        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="end|center_vertical"
            android:padding="4dp">

            <ImageButton
                android:id="@+id/btn_search"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/search_in"
                android:background="@null"
                android:scaleType="centerInside"
                android:layout_gravity="center_vertical"
                android:textSize="14sp"/>

        </LinearLayout>

    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent"
                android:scrollbars="none" 
                tools:ignore="ExtraText"
                android:fillViewport="true"
    >
        
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                      android:baselineAligned="false"
                      android:orientation="horizontal"
                      android:background="@color/theme_surface"
                      >

            <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="500dp"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:orientation="vertical">
                <LinearLayout
                        android:id="@+id/dictation_section"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:layout_margin="10dp"
                        android:orientation="vertical"
                        android:background="@drawable/custom_box_shadow"
                        android:layout_gravity="center_horizontal"
                        android:elevation="10dp"
                        android:enabled="true"
                        android:clickable="true"
                        android:focusable="true">
                    <ImageView
                            android:layout_width="90dp"
                            android:layout_height="90dp"
                            android:src="@drawable/test"
                            android:layout_gravity="center"
                            android:layout_marginTop="25dp"
                            android:id="@+id/image"/>
                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:text="单词听写"
                            android:textSize="30sp"
                            android:layout_marginTop="5dp"
                            android:layout_gravity="center"
                            android:id="@+id/word"/>
                </LinearLayout>
                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="250dp"
                        android:layout_margin="10dp"
                        android:orientation="vertical"
                        android:layout_marginTop="30dp"
                        android:layout_marginBottom="30dp"
                        android:background="@drawable/custom_box_shadow1"
                        android:elevation="10dp"
                        android:layout_gravity="center_horizontal"
                        android:clickable="true"
                        android:focusable="true"
                        android:id="@+id/evaluation_section">
                    <ImageView
                            android:layout_width="90dp"
                            android:layout_height="90dp"
                            android:src="@drawable/tu"
                            android:layout_gravity="center"
                            android:layout_marginTop="60dp"
                            android:id="@+id/image2"/>
                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:text="学情分析"
                            android:textSize="30sp"
                            android:layout_marginTop="5dp"
                            android:layout_gravity="center"
                            android:id="@+id/word2"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="500dp"
                android:layout_gravity="center_vertical"
                android:layout_weight="1"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="250dp"
                    android:layout_margin="10dp"
                    android:orientation="vertical"
                    android:id="@+id/pronunciation_section"
                    android:background="@drawable/custom_box_shadow1"
                    android:elevation="10dp"
                    android:layout_gravity="center_horizontal"
                    android:enabled="true"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:layout_width="90dp"
                        android:layout_height="90dp"
                        android:src="@drawable/enhance"
                        android:layout_gravity="center"
                        android:layout_marginTop="60dp"
                        android:id="@+id/image11"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="发音纠正"
                        android:textSize="30sp"
                        android:layout_marginTop="5dp"
                        android:layout_gravity="center"
                        android:id="@+id/word1"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_margin="10dp"
                    android:orientation="vertical"
                    android:id="@+id/composition_section"
                    android:layout_marginTop="30dp"
                    android:layout_marginBottom="30dp"
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/custom_box_shadow"
                    android:elevation="10dp"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:layout_width="90dp"
                        android:layout_height="90dp"
                        android:src="@drawable/composition_correct"
                        android:layout_gravity="center"
                        android:layout_marginTop="25dp"
                        android:id="@+id/image22"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="作文评分"
                        android:textSize="30sp"
                        android:layout_marginTop="5dp"
                        android:layout_gravity="center"
                        android:id="@+id/word22"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>