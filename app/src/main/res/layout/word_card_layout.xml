<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/word_card"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardCornerRadius="30dp"
    app:cardElevation="4dp"
    android:layout_margin="8dp"
>

    <LinearLayout
        android:id="@+id/word_card_inner"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/custom_wordcard_background"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Word title and phonetic -->
        <LinearLayout
            android:id="@+id/word_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">
            <RelativeLayout android:layout_width="match_parent" android:layout_height="45dp"
                          android:orientation="horizontal"
                          android:layout_marginBottom="8dp"
                          >
                <TextView
                    android:id="@+id/tv_word"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="abandon"
                    android:textSize="32sp"
                    android:textStyle="bold"/>
                <!-- Star button for favorite -->
                <ImageButton
                    android:id="@+id/btn_favorite"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toRightOf="@+id/tv_word"
                    android:layout_marginTop="14dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/baseline_star_border_24"
                    android:background="@null"
                    android:layout_marginLeft="7dp"
                    android:contentDescription="Favorite Button"/>
            </RelativeLayout>

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                          android:orientation="horizontal"
                          android:paddingVertical="4dp"
                          >
                <TextView
                    android:id="@+id/tv_phonetic_US"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="[/əˈbændən/]"
                    android:textSize="14sp"
                    android:textColor="@color/tag_text_color"
                    android:padding="8dp"
                    android:minWidth="44dp"
                    android:minHeight="44dp"
                    android:gravity="center"
                    android:background="?attr/selectableItemBackground"/>
                <TextView
                    android:id="@+id/tv_phonetic_separator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="|"
                    android:textSize="14sp"
                    android:textColor="@color/tag_text_color"
                    android:gravity="center"
                    android:paddingVertical="8dp"/>
                <TextView
                    android:id="@+id/tv_phonetic_UK"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="[/əˈbændən/]"
                    android:textSize="14sp"
                    android:textColor="@color/tag_text_color"
                    android:padding="8dp"
                    android:minWidth="44dp"
                    android:minHeight="44dp"
                    android:gravity="center"
                    android:background="?attr/selectableItemBackground"/>
            </LinearLayout>
            <view class="android.view.View"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/theme_background"
                android:layout_marginTop="16dp"
                />

        </LinearLayout>

        <!-- Hidden definition area initially gone -->
        <LinearLayout
            android:id="@+id/definition_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:visibility="invisible"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingBottom="16dp"
        >

            <TextView
                android:id="@+id/tv_definition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textSize="18sp"/>
            <view class="android.view.View"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/theme_background"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"/>


            <TextView
                android:id="@+id/tv_example"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textColor="@color/tag_text_color"
                android:ellipsize="end"
            />
        </LinearLayout>
    </LinearLayout>
    <RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    >
        <!-- Left zone indicator (water drop left area) -->
        <LinearLayout android:layout_width="wrap_content" android:layout_height="65dp"
                      android:id="@+id/left_zone_indicator"
                      android:layout_toStartOf="@+id/btn_water_drop"
                      android:layout_alignParentBottom="true"
                      android:visibility="invisible"
                      android:alpha="0.6"
                      android:layout_marginBottom="15dp"
                      android:layout_marginEnd="12dp"
                      android:layout_marginStart="15dp"
        >
            <ImageView
                android:layout_width="65dp"
                android:layout_height="65dp"
                android:src="@drawable/understand_zone"
                android:gravity="center"
                android:layout_marginEnd="2dp"
            />
            <ImageView android:layout_width="30dp" android:layout_height="30dp"
                android:id="@+id/b1"
                android:src="@drawable/follow_left"
                android:layout_gravity="center"
                android:scaleType="centerInside"/>


        </LinearLayout>
        <!-- Right zone indicator (water drop left area) -->
        <LinearLayout android:layout_width="wrap_content" android:layout_height="65dp"
                      android:id="@+id/right_zone_indicator"
                      android:layout_toEndOf="@+id/btn_water_drop"
                      android:layout_alignParentBottom="true"
                      android:visibility="invisible"
                      android:alpha="0.6"
                      android:layout_marginBottom="15dp"
                      android:layout_marginStart="12dp"
                      android:layout_marginEnd="15dp"
        >
            <ImageView android:layout_width="30dp" android:layout_height="30dp"
                android:id="@+id/n1"
                android:src="@drawable/follow_right"
                android:layout_gravity="center"
                android:scaleType="centerInside"/>
            <ImageView
                android:layout_width="65dp"
                android:layout_height="65dp"
                android:src="@drawable/oblivion_zone"
                android:gravity="center"
                android:layout_marginStart="2dp"
            />


        </LinearLayout>


        <!-- Water drop button -->
        <ImageButton
            android:id="@+id/btn_water_drop"
            android:layout_width="41dp"
            android:layout_height="41dp"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="27dp"
            android:src="@drawable/water_drop_pre"
            android:alpha="0.6"
            android:background="@android:color/transparent"
            android:scaleType="centerInside"
            android:contentDescription="Water Drop Button"/>
    </RelativeLayout>

</androidx.cardview.widget.CardView>