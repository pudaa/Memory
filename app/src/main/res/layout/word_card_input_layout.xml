<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/word_card"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardCornerRadius="30dp"
    app:cardElevation="4dp"
    android:layout_margin="8dp">

    <LinearLayout
        android:id="@+id/word_card_inner"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/custom_wordcard_background"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 单词标题 + 音标 -->
        <LinearLayout
            android:id="@+id/word_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp">

                <TextView
                    android:id="@+id/tv_word"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="abandon"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btn_favorite"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@+id/tv_word"
                    android:layout_marginStart="7dp"
                    android:layout_marginTop="4dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/baseline_star_border_24"
                    android:background="@null"
                    android:contentDescription="收藏" />
            </RelativeLayout>

            <!-- 音标 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp">

                <TextView
                    android:id="@+id/tv_phonetic_US"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="[/əˈbændən/]"
                    android:textSize="14sp"
                    android:textColor="@color/tag_text_color" android:padding="8dp" android:minWidth="44dp" android:minHeight="44dp" android:gravity="center" android:background="?attr/selectableItemBackground"/>

                <TextView
                    android:id="@+id/tv_phonetic_separator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="|"
                    android:textSize="14sp"
                    android:textColor="@color/tag_text_color" android:paddingVertical="8dp" android:gravity="center"/>

                <TextView
                    android:id="@+id/tv_phonetic_UK"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="[/əˈbændən/]"
                    android:textSize="14sp"
                    android:textColor="@color/tag_text_color" android:padding="8dp" android:minWidth="44dp" android:minHeight="44dp" android:gravity="center" android:background="?attr/selectableItemBackground"/>
            </LinearLayout>

            <!-- FSRS 状态标签 -->
            <LinearLayout
                android:id="@+id/fsrs_info_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:visibility="gone"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp">

                <TextView
                    android:id="@+id/tv_retrievability"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="R:0.85"
                    android:textSize="11sp"
                    android:textColor="@color/middle_gray"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tv_difficulty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="D:4.2"
                    android:textSize="11sp"
                    android:textColor="@color/middle_gray"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tv_stability"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="S:3.5d"
                    android:textSize="11sp"
                    android:textColor="@color/middle_gray" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/theme_background"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- 提示文字 -->
        <TextView
            android:id="@+id/tv_input_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="请输入该单词的中文释义："
            android:textSize="15sp"
            android:textColor="@color/theme_text_secondary"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp"
            android:gravity="center" />

        <!-- 输入区域 -->
        <LinearLayout
            android:id="@+id/input_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <EditText
                android:id="@+id/et_user_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="120dp"
                android:gravity="top|start"
                android:hint="在此输入释义…"
                android:textSize="16sp"
                android:padding="10dp"
                android:background="@drawable/edittext_input_background"
                android:inputType="textMultiLine"
                android:maxLines="4"
                android:scrollbars="vertical" />

            <TextView
                android:id="@+id/tv_ai_feedback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:gravity="center"
                android:textColor="@color/theme_text_primary"
                android:textStyle="bold"
                android:padding="8dp"
                android:visibility="gone"
                android:layout_marginBottom="6dp" />
        </LinearLayout>

        <!-- 反馈区域（初始隐藏） -->
        <LinearLayout
            android:id="@+id/feedback_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tv_feedback_result"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="已提交"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tv_correct_meaning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="标准释义：放弃；抛弃"
                android:textSize="14sp"
                android:gravity="center"
                android:textColor="@color/theme_text_secondary" />
        </LinearLayout>

        <!-- 按钮区域 -->
        <LinearLayout
            android:id="@+id/btn_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_submit"
                android:layout_width="130dp"
                android:layout_height="48dp"
                android:text="提 交"
                android:textSize="16sp"
                android:textColor="@color/white"
                android:background="@drawable/button_confirm_background"
                android:layout_marginEnd="12dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_skip"
                android:layout_width="130dp"
                android:layout_height="48dp"
                android:text="跳 过"
                android:textSize="16sp"
                android:textColor="@color/theme_text_secondary"
                android:background="@drawable/button_skip_background"
                android:layout_marginStart="12dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_next"
                android:layout_width="200dp"
                android:layout_height="48dp"
                android:text="下 一 个"
                android:textSize="16sp"
                android:textColor="@color/white"
                android:background="@drawable/button_next_background"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
