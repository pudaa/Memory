<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/activity_background">

    <LinearLayout
            android:id="@+id/title_bar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/white"
            android:orientation="horizontal"
            android:padding="8dp"
            android:elevation="4dp">

        <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/back"
                android:padding="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:scaleType="fitCenter"
                android:layout_gravity="center_vertical"/>

        <TextView
                android:id="@+id/tv_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="学习计划"
                android:layout_gravity="center"
                android:textSize="23sp"
                android:textStyle="bold"
                android:gravity="center"/>

        <View
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center_vertical"
        />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                  android:orientation="vertical"
                  android:padding="20dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                  android:id="@+id/progress_info_title"
                  android:text="计划书籍"
                  android:textSize="12sp"
                  android:textColor="@color/middle_gray"
                  android:layout_marginBottom="10dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                      android:orientation="horizontal"
                      android:layout_marginBottom="10dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                      android:id="@+id/on_learning_book"
                      android:text=""
                      android:layout_weight="1"
                      android:textSize="18sp"
                      android:textStyle="bold"/>

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                          android:id="@+id/to_exchange_plan"
                          android:orientation="horizontal"
                          android:layout_gravity="center_vertical"
                          android:gravity="center_vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                          android:id="@+id/to_change"
                          android:text="更改"
                          android:textSize="14sp"
                          android:textStyle="bold"
                          android:textColor="@color/middle_gray"
                          android:layout_marginEnd="5dp"/>
                <ImageView android:layout_width="wrap_content" android:layout_height="wrap_content"
                           android:id="@+id/btn_change"
                           android:src="@drawable/baseline_keyboard_arrow_right_24"
                           android:background="@android:color/transparent"/>
            </LinearLayout>
        </LinearLayout>

        <ProgressBar
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:progressDrawable="@drawable/custom_progress_bar"
                android:id="@+id/plan_progress"
                android:layout_marginBottom="10dp"/>

        <!-- 进度信息行 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                      android:orientation="horizontal"
                      android:layout_marginBottom="8dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                      android:id="@+id/progress_main"
                      android:text=""
                      android:textSize="13sp"
                      android:textColor="@color/dark_gray"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                      android:layout_weight="1"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                      android:id="@+id/tv_daily_words"
                      android:text=""
                      android:textSize="13sp"
                      android:textColor="@color/dark_gray"/>
        </LinearLayout>

        <!-- 今日任务行 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                      android:orientation="horizontal"
                      android:layout_marginBottom="8dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                      android:id="@+id/need_review"
                      android:text=""
                      android:textSize="13sp"
                      android:textColor="@color/theme_stress"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                      android:layout_weight="1"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                      android:id="@+id/need_new"
                      android:text=""
                      android:textSize="13sp"
                      android:textColor="@color/theme_stress"/>
        </LinearLayout>

        <!-- FSRS 记忆统计卡片 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                      android:orientation="horizontal"
                      android:layout_marginTop="8dp"
                      android:background="@drawable/custom_setting_item"
                      android:padding="12dp"
                      android:elevation="2dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                          android:layout_weight="1" android:orientation="vertical"
                          android:gravity="center">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                          android:text="记忆稳定度"
                          android:textSize="11sp" android:textColor="@color/middle_gray"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                          android:id="@+id/tv_avg_stability"
                          android:text="--"
                          android:textSize="20sp" android:textStyle="bold"
                          android:textColor="@color/theme_stress"/>
            </LinearLayout>
            <View android:layout_width="1dp" android:layout_height="match_parent"
                  android:background="@color/light_gray"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                          android:layout_weight="1" android:orientation="vertical"
                          android:gravity="center">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                          android:text="平均难度"
                          android:textSize="11sp" android:textColor="@color/middle_gray"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                          android:id="@+id/tv_avg_difficulty"
                          android:text="--"
                          android:textSize="20sp" android:textStyle="bold"
                          android:textColor="@color/theme_stress"/>
            </LinearLayout>
            <View android:layout_width="1dp" android:layout_height="match_parent"
                  android:background="@color/light_gray"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                          android:layout_weight="1" android:orientation="vertical"
                          android:gravity="center">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                          android:text="可提取率"
                          android:textSize="11sp" android:textColor="@color/middle_gray"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                          android:id="@+id/tv_avg_retrievability"
                          android:text="--"
                          android:textSize="20sp" android:textStyle="bold"
                          android:textColor="@color/theme_stress"/>
            </LinearLayout>
        </LinearLayout>

        <!-- 掌握词数 -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                  android:id="@+id/tv_mastered_words"
                  android:text=""
                  android:textSize="12sp" android:textColor="@color/middle_gray"
                  android:layout_marginTop="6dp" android:gravity="center"/>
    </LinearLayout>

    <!-- ========== 预测复习安排 ========== -->
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
              android:text="预测复习安排"
              android:textSize="16sp" android:textStyle="bold"
              android:textColor="@color/dark_gray"
              android:paddingStart="20dp" android:paddingTop="2dp"
              android:layout_marginBottom="10dp"
    />

    <!-- ⚠️ 提示（保留布局但隐藏） -->
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
              android:id="@+id/tv_note"
              android:text=""
              android:visibility="gone"/>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1"
                android:id="@+id/scroll_view">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                      android:id="@+id/on_plan_show"
                      android:orientation="vertical"
                      android:paddingStart="16dp" android:paddingEnd="16dp"
                      android:paddingBottom="24dp"/>
    </ScrollView>


</LinearLayout>
