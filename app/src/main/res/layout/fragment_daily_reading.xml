<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ==================== 主内容区 ==================== -->
    <LinearLayout
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/reader_bg">

    <!-- ==================== 标题栏（应用统一风格） ==================== -->
    <LinearLayout
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:background="@color/white"
        android:padding="8dp"
        android:elevation="4dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:padding="4dp">

            <!-- 收藏夹入口（默认显示） -->
            <ImageButton
                android:id="@+id/btn_history"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/baseline_book_24"
                android:background="@null"
                android:scaleType="centerInside"
                android:layout_gravity="center_vertical"
                android:contentDescription="收藏夹" />

            <!-- 返回今日（查看收藏时显示） -->
            <ImageButton
                android:id="@+id/btn_back_today"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/back"
                android:background="@null"
                android:scaleType="centerInside"
                android:layout_gravity="center_vertical"
                android:visibility="gone"
                android:contentDescription="返回今日文章" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_day_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="每日一读"
            android:layout_weight="1"
            android:gravity="center"
            android:layout_gravity="center"
            android:textSize="23sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="end|center_vertical"
            android:padding="4dp">

            <ImageButton
                android:id="@+id/btn_favorite"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/baseline_star_border_24"
                android:background="@null"
                android:scaleType="centerInside"
                android:layout_gravity="center_vertical"
                android:contentDescription="收藏文章" />
        </LinearLayout>
    </LinearLayout>

    <!-- ==================== 阅读工具栏 ==================== -->
    <LinearLayout
        android:id="@+id/reading_toolbar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:background="@color/reader_card_bg"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="12dp"
        android:elevation="1dp">

        <!-- 预计阅读时间 -->
        <TextView
            android:id="@+id/tv_reading_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text=""
            android:textSize="13sp"
            android:textColor="@color/reader_text_secondary" />

        <!-- 朗读整篇（标题 + 文章正文）：走流式合成，边生成边播 -->
        <ImageButton
            android:id="@+id/btn_read_article"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_reader_read"
            android:background="@drawable/bg_reader_card"
            android:tint="@color/reader_accent_bar"
            android:scaleType="centerInside"
            android:padding="6dp"
            android:contentDescription="朗读标题与正文"
            android:layout_marginEnd="8dp" />

        <!-- 字号缩小 -->
        <ImageButton
            android:id="@+id/btn_font_decrease"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_reader_font_decrease"
            android:background="@drawable/bg_reader_card"
            android:scaleType="centerInside"
            android:contentDescription="缩小字号"
            android:layout_marginEnd="8dp" />

        <!-- 字号放大 -->
        <ImageButton
            android:id="@+id/btn_font_increase"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_reader_font_increase"
            android:background="@drawable/bg_reader_card"
            android:scaleType="centerInside"
            android:contentDescription="放大字号"
            android:layout_marginEnd="4dp" />

        <!-- 刷新文章 -->
        <ImageButton
            android:id="@+id/btn_refresh"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/refresh"
            android:background="@drawable/bg_reader_card"
            android:scaleType="centerInside"
            android:padding="6dp"
            android:contentDescription="刷新文章" />
    </LinearLayout>

    <!-- ==================== 阅读区域 ==================== -->
    <ScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none"
        android:fadingEdge="vertical"
        android:fadingEdgeLength="32dp"
        android:requiresFadingEdge="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="32dp"
            android:paddingBottom="48dp">

            <!-- ========== 文章标题 ========== -->
            <TextView
                android:id="@+id/markdown_title_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="每日一读"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="@color/reader_text"
                android:lineSpacingExtra="8dp"
                android:letterSpacing="0.03" />

            <!-- 标题下装饰线 -->
            <View
                android:layout_width="48dp"
                android:layout_height="2dp"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_section_accent_bar" />

            <!-- ========== 加载指示（三点呼吸，加载态显示 / 就绪后隐藏） ========== -->
            <com.deepsleep.memory.ui.components.LoadingDotsView
                android:id="@+id/content_loading_dots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="-8dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone" />

            <!-- ========== 文章正文 ========== -->
            <TextView
                android:id="@+id/markdown_content_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:textSize="19sp"
                android:textColor="@color/reader_text"
                android:lineSpacingExtra="10dp"
                android:layout_marginBottom="32dp" />

            <!-- ========== 长难句分析标题 ========== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical">

                <View
                    android:layout_width="4dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_section_accent_bar" />

                <TextView
                    android:id="@+id/markdown_sentenceAnalysis_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="长难句分析"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:textColor="@color/reader_section_title"
                    android:letterSpacing="0.03" />

                <!-- 只朗读"长难句分析"这一板块 -->
                <ImageButton
                    android:id="@+id/btn_read_sentence_analysis"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_reader_read"
                    android:background="@drawable/bg_reader_card"
                    android:tint="@color/reader_section_title"
                    android:scaleType="centerInside"
                    android:padding="6dp"
                    android:contentDescription="朗读长难句分析" />
            </LinearLayout>

            <!-- 长难句卡片 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_reader_card"
                android:padding="16dp"
                android:layout_marginBottom="24dp"
                android:elevation="1dp">

                <LinearLayout
                    android:id="@+id/markdown_sentenceAnalysis_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="start" />
            </LinearLayout>

            <!-- ========== 高频易错单词标题 ========== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical">

                <View
                    android:layout_width="4dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_section_accent_bar" />

                <TextView
                    android:id="@+id/markdown_highFrequencyWords_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="高频易错单词"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:textColor="@color/reader_section_title"
                    android:letterSpacing="0.03" />

                <!-- 只朗读"高频易错单词"这一板块 -->
                <ImageButton
                    android:id="@+id/btn_read_high_freq_words"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_reader_read"
                    android:background="@drawable/bg_reader_card"
                    android:tint="@color/reader_section_title"
                    android:scaleType="centerInside"
                    android:padding="6dp"
                    android:contentDescription="朗读高频易错单词" />
            </LinearLayout>

            <!-- 高频单词卡片 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_reader_card"
                android:padding="16dp"
                android:layout_marginBottom="24dp"
                android:elevation="1dp">

                <LinearLayout
                    android:id="@+id/markdown_highFrequencyWords_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="start" />
            </LinearLayout>

            <!-- 加载指示已由标题下方的 content_loading_dots（三点呼吸）承担，
                 原旋转圈删除 -->

        </LinearLayout>
    </ScrollView>

    <!-- ==================== 阅读进度条 ==================== -->
    <ProgressBar
        android:id="@+id/reading_progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:max="100"
        android:progress="0"
        android:progressTint="@color/reader_accent_bar"
        android:background="@color/reader_divider" />

    </LinearLayout><!-- end main_content -->

    <!-- ==================== 遮罩层（抽屉打开时显示） ==================== -->
    <View
        android:id="@+id/drawer_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true" />

    <!-- ==================== 收藏夹侧边抽屉 ====================
         标题栏由实心蓝条白字改为米白底深字 + 分隔线，与全局标题语言一致；
         空状态补插图；全部走 reader_* 色板，明暗自动适配 -->
    <LinearLayout
        android:id="@+id/favorites_drawer"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="@color/reader_card_bg"
        android:translationX="-280dp"
        android:elevation="16dp">

        <!-- 抽屉标题 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="12dp"
            android:background="@color/reader_card_bg">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="收藏夹"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/reader_text" />

            <ImageButton
                android:id="@+id/btn_close_drawer"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/baseline_arrow_back_ios_new_24"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:scaleType="centerInside"
                android:tint="@color/reader_text_secondary"
                android:contentDescription="关闭" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/reader_divider" />

        <!-- 列表 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ListView
                android:id="@+id/favorites_list_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@null"
                android:dividerHeight="0dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:clipToPadding="false"
                android:scrollbars="none" />

            <!-- 空状态：图标 + 文案（favorites_empty_view 的 id 必须保留，
                 Java 侧对该 TextView 做 setVisibility / setText） -->
            <LinearLayout
                android:id="@+id/favorites_empty_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_reading_favorite_icon"
                    android:padding="20dp"
                    android:src="@drawable/baseline_book_24"
                    android:tint="@color/reader_section_title"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/favorites_empty_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="还没有收藏过文章"
                    android:textSize="14sp"
                    android:textColor="@color/reader_text_secondary" />
            </LinearLayout>

            <!-- 加载中：三点呼吸（阅读页色板） -->
            <com.deepsleep.memory.ui.components.LoadingDotsView
                android:id="@+id/favorites_loading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone"
                app:ldvDotDiameter="7dp"
                app:ldvDotGap="5dp"
                app:ldvDotColor="@color/reader_accent_bar" />
        </FrameLayout>
    </LinearLayout>

</FrameLayout>