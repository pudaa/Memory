<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/theme_surface">

    <!-- ═══ 标题栏 ═══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/white"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="12dp"
        android:gravity="center_vertical"
        android:elevation="1dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/back"
            android:padding="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="fitCenter" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="听写练习"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="@color/theme_text_primary" />

        <View
            android:layout_width="44dp"
            android:layout_height="44dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="20dp"
            android:paddingBottom="32dp"
            android:gravity="center_horizontal">

            <!-- ═══ 进度指示 ═══ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginBottom="20dp">

                <TextView
                    android:id="@+id/tv_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1 / 15"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/theme_stress"
                    android:letterSpacing="0.02" />

                <!-- 进度轨道 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/progress_fill_view"
                        android:layout_width="0dp"
                        android:layout_height="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/progress_track" />
                </LinearLayout>
            </LinearLayout>

            <!-- ═══ 语境卡片 ═══ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/dictation_card_bg"
                android:elevation="2dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="28dp"
                android:paddingBottom="28dp"
                android:layout_marginBottom="20dp">

                <!-- 级别标签 -->
                <TextView
                    android:id="@+id/tv_level"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="单词听写"
                    android:textSize="12sp"
                    android:textColor="@color/theme_text_secondary"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:background="#F0F0F5"
                    android:layout_marginBottom="16dp" />

                <!-- 音频加载中 -->
                <ProgressBar
                    android:id="@+id/progress_audio"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:visibility="gone"
                    android:layout_marginBottom="12dp"
                    android:indeterminateTint="@color/theme_stress" />

                <!-- 语境文本 -->
                <TextView
                    android:id="@+id/tv_context"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="请听写以下单词"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:textColor="@color/theme_text_primary"
                    android:lineSpacingExtra="8dp" />
            </LinearLayout>

            <!-- ═══ 操作按钮行 ═══ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="28dp">

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/btn_replay"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="重听"
                    app:icon="@drawable/trumpet"
                    android:textSize="14sp"
                    android:textColor="@color/theme_stress"
                    android:backgroundTint="@android:color/transparent"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:minWidth="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    style="?attr/materialButtonOutlinedStyle" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/btn_scan"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="拍照输入"
                    android:textSize="14sp"
                    android:textColor="@color/theme_text_secondary"
                    android:backgroundTint="@android:color/transparent"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:layout_marginStart="12dp"
                    android:minWidth="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    style="?attr/materialButtonOutlinedStyle" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />
            </LinearLayout>

            <!-- ═══ 输入区域 ═══ -->
            <LinearLayout
                android:id="@+id/answer_input_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="visible">

                <!-- 下划线输入框 -->
                <EditText
                    android:id="@+id/et_answer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="输入你听到的内容"
                    android:textSize="20sp"
                    android:textColorHint="#C0C0CC"
                    android:gravity="center"
                    android:inputType="text|textNoSuggestions|textVisiblePassword"
                    android:importantForAutofill="no"
                    android:imeOptions="actionDone"
                    android:background="@null"
                    android:paddingTop="12dp"
                    android:paddingBottom="14dp"
                    android:maxLines="1" />

                <!-- 引导下划线 -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1.5dp"
                    android:background="#E0E0E8" />

                <!-- 下一步按钮 -->
                <Button
                    android:id="@+id/btn_next"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="下一个"
                    android:textSize="17sp"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:backgroundTint="@color/theme_stress"
                    android:layout_marginTop="28dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:cornerRadius="26dp" />
            </LinearLayout>
(
            <!-- ═══ 提交区域（全部作答后显示） ═══ -->
            <LinearLayout
                android:id="@+id/submit_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="所有单词已作答完毕"
                    android:textSize="18sp"
                    android:textColor="@color/theme_text_primary"
                    android:layout_marginBottom="28dp" />

                <Button
                    android:id="@+id/btn_submit"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="提交答案"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:backgroundTint="@color/theme_stress"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:cornerRadius="28dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>

