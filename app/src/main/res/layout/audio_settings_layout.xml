<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">

    <!-- ═══ 标题栏（固定在 ScrollView 之外，与主设置界面结构一致）═══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/white"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="12dp"
        android:gravity="center_vertical"
        android:elevation="4dp">

        <ImageButton
            android:id="@+id/audio_settings_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/back"
            android:padding="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="fitCenter"
            android:contentDescription="@string/play_audio" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="朗读与音频"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="@color/theme_text_primary" />

        <View
            android:layout_width="44dp"
            android:layout_height="44dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="12dp"
                android:text="AI 对话朗读"
                android:textColor="@color/dark_gray"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- 自动朗读开关 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp"
                android:padding="16dp"
                android:background="@drawable/custom_setting_item"
                android:elevation="2dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AI 回复自动朗读"
                        android:textSize="18sp"
                        android:textColor="@color/theme_text_primary" />

                    <TextView
                        android:id="@+id/tv_auto_play_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textSize="13sp"
                        android:textColor="@color/dark_gray" />
                </LinearLayout>

                <Switch
                    android:id="@+id/switch_auto_play_audio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="12dp" />
            </LinearLayout>

            <!-- 说明文字 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginEnd="6dp"
                    android:src="@drawable/ic_mode_tip"
                    android:scaleType="fitCenter"
                    android:contentDescription="@string/play_audio" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/dark_gray"
                    android:text="· 关闭时：AI 回复到达后不会立即生成语音，点每条回复下方的朗读按钮才开始生成并播放。\n· 开启时：AI 回复一说完就自动开始朗读，更接近日常对话的节奏。\n\n提示：语音为实时合成，每条回复朗读一次都会占用一次语音生成。开启自动朗读后，每条回复都会消耗一次生成，在低配设备上可能与其他识别功能互相排队。" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
