<?xml version="1.0" encoding="utf-8"?>
<!-- 垂直线性布局：标题栏 / 进度轨道 / 卡片容器依次排列。
     容器以 weight=1 填充剩余空间，进度轨道显隐时空间自动回收，
     不会出现静态 marginTop 留下的空白带 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_stack_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/card_background"
>


    <LinearLayout
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:background="@color/white"
        android:padding="8dp"
        android:elevation="4dp">


        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:visibility="visible"
            android:orientation="horizontal"
            android:padding="4dp">

            <ImageButton
                android:id="@+id/btn_plan"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/program_revisions"
                android:background="@null"
                android:scaleType="centerInside"
                android:layout_gravity="center_vertical"
                android:textSize="14sp"
            />


        </LinearLayout>


        <TextView
                android:id="@+id/tv_day_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="单词学习"
                android:layout_gravity="center"
                android:textSize="23sp"
                android:textStyle="bold"/>




        <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="end|center_vertical"
                android:padding="4dp">

            <ImageButton
                    android:id="@+id/btn_search"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/search_in"
                    android:background="@null"
                    android:scaleType="centerInside"
                    android:layout_gravity="center_vertical"
                    android:textSize="14sp"/>

        </LinearLayout>

    </LinearLayout>


    <com.deepsleep.memory.ui.main_view.WordCardContainer
        android:id="@+id/word_card_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        >


    </com.deepsleep.memory.ui.main_view.WordCardContainer>

    <!-- 卡片进度点阵：位于卡片下方，居中窄条。
         点数固定上限 9，卡片较多时按区间均分映射；
         当前卡所在点的圆点拉宽为胶囊（圆 → 圆角矩形形变）；
         点色区分复习(蓝)/新学(橙)，透明度编码完成度；
         点击点跳到对应区间首卡。总结态自动隐藏 -->
    <com.deepsleep.memory.ui.components.CardProgressTrack
        android:id="@+id/card_progress_track"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="-9dp"
        android:layout_marginBottom="4dp"
        android:visibility="gone" />

</LinearLayout>
