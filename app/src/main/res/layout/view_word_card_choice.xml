<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/word_card"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardCornerRadius="30dp"
    app:cardElevation="4dp"
    android:layout_margin="8dp">

    <LinearLayout
        android:id="@+id/word_card_inner"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/custom_wordcard_background"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 单词标题 + 音标 -->
        <LinearLayout
            android:id="@+id/word_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp">

                <TextView
                    android:id="@+id/tv_word"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="abandon"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <!-- 收藏按钮 -->
                <ImageButton
                    android:id="@+id/btn_favorite"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@+id/tv_word"
                    android:layout_marginStart="7dp"
                    android:layout_marginTop="4dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/baseline_star_border_24"
                    android:background="@null"
                    android:contentDescription="收藏" />
            </RelativeLayout>

            <!-- 音标 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="0dp">

                <TextView
                    android:id="@+id/tv_phonetic_US"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="[/əˈbændən/]"
                    android:textSize="14sp"
                    android:textColor="@color/tag_text_color" android:padding="8dp" android:minWidth="44dp" android:minHeight="30dp" android:gravity="center" android:background="?attr/selectableItemBackground"/>

                <TextView
                    android:id="@+id/tv_phonetic_separator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="|"
                    android:textSize="14sp"
                    android:textColor="@color/tag_text_color" android:paddingVertical="8dp" android:gravity="center"/>

                <TextView
                    android:id="@+id/tv_phonetic_UK"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="[/əˈbændən/]"
                    android:textSize="14sp"
                    android:textColor="@color/tag_text_color" android:padding="8dp" android:minWidth="44dp" android:minHeight="30dp" android:gravity="center" android:background="?attr/selectableItemBackground"/>
            </LinearLayout>

            <!-- FSRS 状态标签（复习词显示） -->
            <LinearLayout
                android:id="@+id/fsrs_info_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:visibility="gone"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp">

                <TextView
                    android:id="@+id/tv_retrievability"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="R:0.85"
                    android:textSize="11sp"
                    android:textColor="@color/middle_gray"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tv_difficulty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="D:4.2"
                    android:textSize="11sp"
                    android:textColor="@color/middle_gray"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tv_stability"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="S:3.5d"
                    android:textSize="11sp"
                    android:textColor="@color/middle_gray" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/theme_background"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- 提示文字 -->
        <TextView
            android:id="@+id/tv_choice_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="请选择最合适的释义："
            android:textSize="15sp"
            android:textColor="@color/theme_text_secondary"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp"
            android:gravity="center" />

        <!-- 四个选项 -->
        <LinearLayout
            android:id="@+id/options_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/option_a_card"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:id="@+id/option_a"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:padding="12dp"
                        android:background="@drawable/option_background_default"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/option_a_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="A"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/middle_gray" />

                        <TextView
                            android:id="@+id/option_a_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="放弃"
                            android:textSize="16sp"
                            android:gravity="center"
                            android:maxLines="2"
                            android:ellipsize="end" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/option_b_card"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:id="@+id/option_b"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:padding="12dp"
                        android:background="@drawable/option_background_default"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/option_b_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="B"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/middle_gray" />

                        <TextView
                            android:id="@+id/option_b_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="抛弃"
                            android:textSize="16sp"
                            android:gravity="center"
                            android:maxLines="2"
                            android:ellipsize="end" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <androidx.cardview.widget.CardView
                    android:id="@+id/option_c_card"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:id="@+id/option_c"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:padding="12dp"
                        android:background="@drawable/option_background_default"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/option_c_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="C"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/middle_gray" />

                        <TextView
                            android:id="@+id/option_c_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="接受"
                            android:textSize="16sp"
                            android:gravity="center"
                            android:maxLines="2"
                            android:ellipsize="end" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/option_d_card"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:id="@+id/option_d"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:padding="12dp"
                        android:background="@drawable/option_background_default"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/option_d_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="D"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/middle_gray" />

                        <TextView
                            android:id="@+id/option_d_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="吸收"
                            android:textSize="16sp"
                            android:gravity="center"
                            android:maxLines="2"
                            android:ellipsize="end" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </LinearLayout>

        <!-- 反馈区域（初始隐藏） -->
        <LinearLayout
            android:id="@+id/feedback_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tv_feedback_result"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✅ 正确！"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tv_correct_meaning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="正确释义：放弃；抛弃"
                android:textSize="15sp"
                android:gravity="center"
                android:textColor="@color/theme_text_secondary" />
        </LinearLayout>

        <!-- 确认按钮 -->
        <LinearLayout
            android:id="@+id/btn_confirm_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="12dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_confirm"
                android:layout_width="200dp"
                android:layout_height="48dp"
                android:text="确 认"
                android:textSize="16sp"
                android:textColor="@color/white"
                android:background="@drawable/button_confirm_background"
                android:enabled="false" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_next"
                android:layout_width="200dp"
                android:layout_height="48dp"
                android:text="下 一 个"
                android:textSize="16sp"
                android:textColor="@color/white"
                android:background="@drawable/button_next_background"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
