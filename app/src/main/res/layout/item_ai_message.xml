<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <!-- 用户文本气泡：右下收角 -->
    <LinearLayout
        android:id="@+id/layoutUserMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginStart="56dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_chat_bubble_user"
        android:orientation="vertical"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvUserContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/chat_bubble_user_text"
            android:lineSpacingExtra="2dp" />
    </LinearLayout>

    <!-- 用户语音气泡 -->
    <LinearLayout
        android:id="@+id/layoutUserVoice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginStart="56dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_chat_bubble_user"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="10dp"
        android:paddingRight="14dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <ImageButton
            android:id="@+id/btnUserVoicePlay"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@null"
            android:src="@drawable/ic_play_arrow_24"
            android:tint="@color/chat_bubble_user_text"
            android:scaleType="fitCenter"
            android:contentDescription="@string/play_audio" />

        <ImageView
            android:id="@+id/viewVoiceWave"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="6dp"
            android:src="@drawable/ic_graphic_eq_24"
            android:tint="@color/chat_bubble_user_text"
            android:alpha="0.75"
            android:scaleType="fitCenter"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/tvVoiceDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="0″"
            android:textSize="12sp"
            android:textColor="@color/chat_bubble_user_text"
            android:alpha="0.85" />
    </LinearLayout>

    <!-- AI 消息：圆形头像 + 气泡（左下收角） -->
    <LinearLayout
        android:id="@+id/layoutAiMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:orientation="horizontal"
        android:gravity="top"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvAiAvatar"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginTop="2dp"
            android:background="@drawable/bg_chat_avatar"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="AI"
            android:textColor="@color/chat_avatar_text"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_chat_bubble_ai"
            android:orientation="vertical"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/tvAiContent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/theme_text_primary"
                android:lineSpacingExtra="2dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/chat_on_accent"
                app:chipBackgroundColor="@color/theme_stress"
                app:chipStrokeWidth="0dp"
                app:chipCornerRadius="10dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/layoutEvaluation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupEval"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleLine="false"
                    app:chipSpacingHorizontal="6dp"
                    app:chipSpacingVertical="6dp" />

                <TextView
                    android:id="@+id/tvFeedback"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="@color/theme_text_secondary"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 朗读按钮：圆形浅底 + 喇叭图标，替代原先的裸三角 -->
            <ImageButton
                android:id="@+id/btnPlayAudio"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_chat_play_button"
                android:src="@drawable/ic_volume_up_24"
                android:contentDescription="@string/play_audio"
                android:visibility="gone"
                android:padding="6dp"
                android:tint="@color/theme_stress"
                android:scaleType="fitCenter" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
