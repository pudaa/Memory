<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/summary_card"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardCornerRadius="30dp"
    app:cardElevation="4dp"
    android:layout_margin="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/custom_wordcard_background"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <!-- 完成插图：原为 48sp 的 🎉 文本 emoji。
             单色 celebration 图标喜庆感不足，改用组合矢量（彩笛 + 星点散布），
             多色内嵌主题色引用，不可再加 tint -->
        <FrameLayout
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_summary_badge">

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_celebrate_burst"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="今日学习已完成！"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/theme_text_primary"
            android:layout_marginBottom="6dp"/>

        <!-- 统计概览：图标由布局固定持有，文案只承载数字
             （原先 ✅/❌ 由 Java 拼进字符串，emoji 各系统渲染不一致） -->
        <LinearLayout
            android:id="@+id/summary_stats_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="4dp"
                android:src="@drawable/ic_check_circle_24"
                android:tint="@color/theme_stress"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/tv_summary_correct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="13sp"
                android:textColor="@color/theme_stress"
                android:layout_marginEnd="16dp"/>

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="4dp"
                android:src="@drawable/ic_cancel_24"
                android:tint="@color/theme_error"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/tv_summary_wrong"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="13sp"
                android:textColor="@color/theme_error"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="复习回顾"
            android:textSize="14sp"
            android:textColor="@color/theme_text_secondary"
            android:layout_marginBottom="8dp"/>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/summary_word_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"/>
        </ScrollView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="明天继续加油！"
            android:textSize="14sp"
            android:textColor="@color/theme_stress"
            android:layout_marginTop="16dp"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
