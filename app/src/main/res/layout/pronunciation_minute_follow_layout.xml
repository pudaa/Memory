<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/theme_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 标题栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/white"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="12dp"
            android:gravity="center_vertical"
            android:elevation="1dp">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/back"
                android:padding="10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:scaleType="fitCenter"
                android:contentDescription="返回按钮" />

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="每日一分钟"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"
                android:textColor="@color/theme_text_primary" />

            <View
                android:layout_width="44dp"
                android:layout_height="44dp" />
        </LinearLayout>

        <!-- 波浪装饰 -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:src="@drawable/ic_follow_wave"
            android:scaleType="fitXY"
            android:contentDescription="@null" />

        <!-- 操作提示卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_tip_card"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/baseline_tips_and_updates_24"
                android:tint="@color/theme_primary"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="点击单词卡片展开，跟读示范发音后录音评分"
                android:textSize="13sp"
                android:textColor="@color/theme_text_secondary"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <ListView
            android:id="@+id/words_list_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingTop="4dp"
            android:paddingBottom="12dp"
            android:clipToPadding="false"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:scrollbars="vertical" />
    </LinearLayout>

    <!-- 评分 Bottom Sheet（支持滚动 + 单词详情/成绩总结双模式） -->
    <LinearLayout
        android:id="@+id/bottom_sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_bottom_sheet"
        android:elevation="4dp"
        android:paddingBottom="24dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        app:behavior_hideable="true"
        app:behavior_skipCollapsed="true">

        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- 可滚动内容区 -->
        <ScrollView
            android:id="@+id/bs_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- ====== 单词详情区（默认显示） ====== -->
                <LinearLayout
                    android:id="@+id/bs_word_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- 得分圆形区域 -->
                    <FrameLayout
                        android:id="@+id/bs_score_circle"
                        android:layout_width="88dp"
                        android:layout_height="88dp"
                        android:layout_gravity="center"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_follow_score_circle">

                        <TextView
                            android:id="@+id/bs_score"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="--"
                            android:textSize="36sp"
                            android:textStyle="bold"
                            android:textColor="@color/white" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/bs_level"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="8dp"
                        android:text=""
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/theme_primary"
                        android:visibility="gone" />

                    <!-- 文本对比卡片 -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/bs_text_compare"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:layout_marginEnd="20dp"
                        android:layout_marginTop="18dp"
                        app:cardElevation="1dp"
                        app:cardCornerRadius="12dp"
                        app:cardBackgroundColor="@color/card_background"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="你说："
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="@color/theme_text_secondary"
                                android:layout_marginBottom="4dp" />

                            <TextView
                                android:id="@+id/bs_asr_text"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textSize="16sp"
                                android:textColor="@color/theme_text_primary"
                                android:textStyle="italic" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- 音素详情 -->
                    <TextView
                        android:id="@+id/bs_phoneme"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:layout_marginEnd="20dp"
                        android:layout_marginTop="10dp"
                        android:text=""
                        android:textSize="13sp"
                        android:textColor="@color/theme_text_secondary"
                        android:visibility="gone" />

                    <!-- 逐词评分列表（含音素错误详情） -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/bs_word_scores_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:layout_marginEnd="20dp"
                        android:layout_marginTop="12dp"
                        app:cardElevation="1dp"
                        app:cardCornerRadius="12dp"
                        app:cardBackgroundColor="@color/card_background"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="逐词评分"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="@color/theme_text_secondary"
                                android:layout_marginBottom="8dp" />

                            <LinearLayout
                                android:id="@+id/bs_word_scores"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- 反馈文本 -->
                    <TextView
                        android:id="@+id/bs_feedback"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:layout_marginEnd="20dp"
                        android:layout_marginTop="12dp"
                        android:text=""
                        android:textSize="14sp"
                        android:textColor="@color/theme_text_primary"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- ====== 成绩总结区（词书练完后显示） ====== -->
                <LinearLayout
                    android:id="@+id/bs_summary_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="今日练习总结"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/theme_text_primary"
                        android:gravity="center"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="16dp" />

                    <!-- 总分卡片 -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/bs_summary_overview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:layout_marginEnd="20dp"
                        app:cardElevation="1dp"
                        app:cardCornerRadius="12dp"
                        app:cardBackgroundColor="@color/card_background">

                        <LinearLayout
                            android:id="@+id/bs_summary_stats"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- 单词详情卡片 -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:layout_marginEnd="20dp"
                        android:layout_marginTop="12dp"
                        app:cardElevation="1dp"
                        app:cardCornerRadius="12dp"
                        app:cardBackgroundColor="@color/card_background">

                        <LinearLayout
                            android:id="@+id/bs_summary_words"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- 错误分析卡片 -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:layout_marginEnd="20dp"
                        android:layout_marginTop="12dp"
                        app:cardElevation="1dp"
                        app:cardCornerRadius="12dp"
                        app:cardBackgroundColor="@color/card_background">

                        <LinearLayout
                            android:id="@+id/bs_summary_errors"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp" />
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bs_close_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="12dp"
            android:text="关闭"
            style="@style/Widget.MaterialComponents.Button.TextButton" />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>