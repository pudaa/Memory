<?xml version="1.0" encoding="utf-8"?>
<!-- AI建议 Tab 内容（三层结构 + 快照门控） -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scrollbars="none"
    android:background="@color/theme_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- ===== 第3层：即时反馈（顶部醒目） ===== -->
        <LinearLayout
            android:id="@+id/realtime_alert_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_round_bg"
            android:elevation="2dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="14dp"
            android:layout_marginBottom="12dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/iv_alert_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="10dp"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/tv_realtime_alert"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text=""
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/theme_text_primary"
                android:lineSpacingMultiplier="1.3" />
        </LinearLayout>

        <!-- ── 整体评价 ── -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginTop="8dp" android:layout_marginBottom="8dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="整体评价" android:textSize="17sp" android:textStyle="bold"
                android:textColor="@color/theme_text_primary" />
            <View android:layout_width="0dp" android:layout_height="1dp"
                android:layout_weight="1" android:layout_marginStart="12dp" android:layout_marginEnd="4dp"
                android:background="@drawable/section_divider_line" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/card_round_bg" android:elevation="1dp"
            android:padding="16dp" android:layout_marginBottom="12dp">
            <TextView android:id="@+id/tv_overall_assessment"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="加载中..." android:textSize="15sp"
                android:textColor="@color/theme_text_primary" android:lineSpacingMultiplier="1.5" />
        </LinearLayout>

        <!-- ── 学习强度 + 趋势 ── -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:baselineAligned="false"
            android:layout_marginBottom="12dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:background="@drawable/card_round_bg" android:elevation="1dp"
                android:padding="14dp" android:orientation="vertical" android:gravity="center"
                android:layout_marginEnd="6dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="学习强度" android:textSize="13sp" android:textColor="@color/theme_text_secondary" />
                <TextView android:id="@+id/tv_intensity_level"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="--" android:textSize="16sp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:background="@drawable/card_round_bg" android:elevation="1dp"
                android:padding="14dp" android:orientation="vertical" android:gravity="center"
                android:layout_marginStart="6dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="趋势" android:textSize="13sp" android:textColor="@color/theme_text_secondary" />
                <TextView android:id="@+id/tv_trend"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="--" android:textSize="16sp" android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- ── 薄弱分析 ── -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginTop="4dp" android:layout_marginBottom="8dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="薄弱分析" android:textSize="17sp" android:textStyle="bold"
                android:textColor="@color/theme_text_primary" />
            <View android:layout_width="0dp" android:layout_height="1dp"
                android:layout_weight="1" android:layout_marginStart="12dp" android:layout_marginEnd="4dp"
                android:background="@drawable/section_divider_line" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/card_round_bg" android:elevation="1dp"
            android:padding="16dp" android:layout_marginBottom="12dp">
            <TextView android:id="@+id/tv_weakness_analysis"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="加载中..." android:textSize="14sp"
                android:textColor="@color/theme_text_secondary" android:lineSpacingMultiplier="1.4" />
        </LinearLayout>

        <!-- ── 个性化建议 ── -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginTop="4dp" android:layout_marginBottom="8dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="个性化建议" android:textSize="17sp" android:textStyle="bold"
                android:textColor="@color/theme_text_primary" />
            <View android:layout_width="0dp" android:layout_height="1dp"
                android:layout_weight="1" android:layout_marginStart="12dp" android:layout_marginEnd="4dp"
                android:background="@drawable/section_divider_line" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/suggestions_layout"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/card_round_bg" android:elevation="1dp"
            android:orientation="vertical" android:padding="8dp"
            android:layout_marginBottom="12dp" />

        <!-- ── 推荐设置 ── -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginTop="4dp" android:layout_marginBottom="8dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="推荐设置" android:textSize="17sp" android:textStyle="bold"
                android:textColor="@color/theme_text_primary" />
            <View android:layout_width="0dp" android:layout_height="1dp"
                android:layout_weight="1" android:layout_marginStart="12dp" android:layout_marginEnd="4dp"
                android:background="@drawable/section_divider_line" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/card_round_bg" android:elevation="1dp"
            android:orientation="vertical" android:padding="16dp"
            android:layout_marginBottom="12dp">
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:baselineAligned="false">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:gravity="center" android:padding="8dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="学习模式" android:textSize="12sp" android:textColor="@color/theme_text_secondary" />
                    <TextView android:id="@+id/tv_recommended_mode"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="--" android:textSize="18sp" android:textStyle="bold"
                        android:textColor="@color/theme_stress" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:gravity="center" android:padding="8dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="每日新词" android:textSize="12sp" android:textColor="@color/theme_text_secondary" />
                    <TextView android:id="@+id/tv_suggested_daily_new_words"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="--" android:textSize="18sp" android:textStyle="bold"
                        android:textColor="@color/theme_stress" />
                </LinearLayout>
            </LinearLayout>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_apply_settings"
                android:layout_width="match_parent" android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:text="应用推荐设置" android:textSize="15sp"
                android:textColor="@color/theme_on_primary"
                app:backgroundTint="@color/theme_primary"
                app:cornerRadius="8dp" />
        </LinearLayout>

        <!-- ===== 第1层：长期学习规划 ===== -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginTop="4dp" android:layout_marginBottom="8dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="长期学习规划" android:textSize="17sp" android:textStyle="bold"
                android:textColor="@color/theme_text_primary" />
            <View android:layout_width="0dp" android:layout_height="1dp"
                android:layout_weight="1" android:layout_marginStart="12dp" android:layout_marginEnd="4dp"
                android:background="@drawable/section_divider_line" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/long_term_plan_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_round_bg"
            android:elevation="1dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:visibility="gone">

            <!-- 阶段 -->
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginBottom="6dp">
                <ImageView
                    android:layout_width="16dp" android:layout_height="16dp"
                    android:src="@drawable/ic_info_outline"
                    android:layout_marginEnd="8dp"
                    android:importantForAccessibility="no" />
                <TextView android:id="@+id/tv_ltp_phase"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="" android:textSize="15sp" android:textStyle="bold"
                    android:textColor="@color/theme_text_primary" />
            </LinearLayout>

            <!-- 目标 -->
            <TextView android:id="@+id/tv_ltp_goal"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="" android:textSize="14sp"
                android:textColor="@color/theme_text_secondary"
                android:layout_marginBottom="12dp"
                android:layout_marginStart="24dp" />

            <!-- 里程碑标题 -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="里程碑" android:textSize="13sp" android:textStyle="bold"
                android:textColor="@color/theme_text_secondary"
                android:layout_marginBottom="6dp" />

            <!-- 里程碑列表 -->
            <LinearLayout
                android:id="@+id/milestones_layout"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="12dp" />

            <!-- 分割线：两侧虚线 + 中间实线（虚线用 Canvas 绘制 View，渲染稳定） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">
                <com.deepsleep.memory.ui.components.DashedDividerView
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />
                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@drawable/divider_solid_line" />
                <com.deepsleep.memory.ui.components.DashedDividerView
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />
            </LinearLayout>

            <!-- 下次调整条件 -->
            <TextView android:id="@+id/tv_ltp_next_adjust"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="" android:textSize="13sp"
                android:textColor="@color/theme_stress"
                android:layout_marginBottom="8dp" />

            <!-- 说明 -->
            <TextView android:id="@+id/tv_ltp_rationale"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="" android:textSize="13sp"
                android:textColor="@color/theme_text_secondary"
                android:lineSpacingMultiplier="1.3" />
        </LinearLayout>

        <!-- 底部留白 -->
        <View android:layout_width="0dp" android:layout_height="20dp" />

    </LinearLayout>
</ScrollView>
