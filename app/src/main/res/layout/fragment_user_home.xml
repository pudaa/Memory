<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
             xmlns:tools="http://schemas.android.com/tools"
             android:layout_width="match_parent"
             android:layout_height="match_parent">
    <LinearLayout
                  android:layout_width="match_parent"
                  android:layout_height="match_parent"
                  android:orientation="vertical"
                  android:background="@color/theme_surface"
                  tools:ignore="UselessParent">
        <LinearLayout
            android:id="@+id/title_bar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:orientation="horizontal"
            android:background="@color/white"
            android:padding="8dp"
            android:elevation="4dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:visibility="invisible"
                android:orientation="horizontal"
                android:padding="4dp">

                <ImageButton
                    android:id="@+id/btn_plan"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/program_revisions"
                    android:background="@null"
                    android:scaleType="centerInside"
                    android:layout_gravity="center_vertical"
                    android:textSize="14sp"
                />


            </LinearLayout>

            <TextView
                    android:id="@+id/tv_day_count"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="个人空间"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:textSize="23sp"
                    android:textStyle="bold"/>


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:visibility="invisible"
                android:orientation="horizontal"
                android:gravity="end|center_vertical"
                android:padding="4dp">

                <ImageButton
                    android:id="@+id/btn_refresh"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/refresh"
                    android:background="@null"
                    android:scaleType="centerInside"
                    android:layout_gravity="center_vertical"
                    android:textSize="14sp"/>

            </LinearLayout>

        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                      android:layout_gravity="center_horizontal"
                      android:padding="18dp"
                      android:orientation="vertical">
            <ImageView android:layout_width="120dp" android:layout_height="120dp"
                       android:id="@+id/avatar_image"
                       android:layout_gravity="center_horizontal"
                       android:src="@drawable/default_avatar"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                      android:text="用户名"
                      android:id="@+id/nick_name"
                      android:layout_gravity="center_horizontal"
                      android:layout_margin="5dp"
                      android:textSize="25sp"
                      android:textStyle="bold"
                      />
        </LinearLayout>
        <view class="android.view.View"
              android:layout_width="match_parent"
              android:layout_height="1dp"
              android:background="@color/light_gray"
              android:layout_marginBottom="16dp"
        />
        <RelativeLayout android:layout_width="match_parent" android:layout_height="60dp"
                        android:layout_gravity="center_horizontal"
                        android:background="@drawable/custom_listitem_shadow"
                        android:id="@+id/layout_my_favorite"
                        android:layout_margin="16dp"
                        android:elevation="2dp"
                        android:orientation="vertical"
        >
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                      android:text="我的收藏"
                      android:id="@+id/favorite"
                      android:layout_centerVertical="true"
                      android:layout_marginStart="19dp"
                      android:textSize="20sp"
                      />
            <ImageButton android:layout_width="30dp" android:layout_height="wrap_content"
                         android:id="@+id/btn_to_favorite"
                         android:src="@drawable/next"
                         android:layout_alignParentEnd="true"
                         android:layout_centerVertical="true"
                         android:layout_margin="16dp"
                         android:background="@null"
                         android:scaleType="fitCenter"/>
        </RelativeLayout>
        <RelativeLayout android:layout_width="match_parent" android:layout_height="60dp"
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/layout_setting"
                        android:background="@drawable/custom_listitem_shadow"
                        android:layout_margin="16dp"
                        android:elevation="2dp"
                        android:orientation="vertical"
        >
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                      android:text="设       置"
                      android:id="@+id/setting"
                      android:layout_centerVertical="true"
                      android:layout_marginStart="19dp"
                      android:textSize="20sp"
                      />
            <ImageButton android:layout_width="30dp" android:layout_height="wrap_content"
                         android:id="@+id/btn_to_setting"
                         android:src="@drawable/next"
                         android:layout_alignParentEnd="true"
                         android:layout_centerVertical="true"
                         android:layout_margin="16dp"
                         android:background="@null"
                         android:scaleType="fitCenter"/>
        </RelativeLayout>
        <RelativeLayout android:layout_width="match_parent" android:layout_height="60dp"
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/layout_about_us"
                        android:background="@drawable/custom_listitem_shadow"
                        android:layout_margin="16dp"
                        android:elevation="2dp"
                        android:orientation="vertical"
        >
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                      android:text="快速了解"
                      android:id="@+id/about_us"
                      android:layout_centerVertical="true"
                      android:layout_marginStart="19dp"
                      android:textSize="20sp"
            />
            <ImageButton android:layout_width="30dp" android:layout_height="wrap_content"
                         android:id="@+id/btn_to_about_us"
                         android:src="@drawable/next"
                         android:layout_alignParentEnd="true"
                         android:layout_centerVertical="true"
                         android:layout_margin="16dp"
                         android:background="@null"
                         android:scaleType="fitCenter"/>
        </RelativeLayout>

    </LinearLayout>
    <RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    >
        <Button
            android:id="@+id/btn_relogin"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="32dp"
            android:layout_marginEnd="16dp"
            android:layout_alignParentBottom="true"
            android:text="@string/relogin_button"
            android:textSize="20sp"
            android:stateListAnimator="@null"
            android:elevation="2dp"
            android:background="@drawable/custom_shadow"
         />
    </RelativeLayout>
</FrameLayout>
