<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="14dp"
    android:background="@drawable/item_bg_selector"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
    android:layout_marginBottom="8dp">

    <TextView
        android:id="@+id/tv_preview_index"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:text="1"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:background="@drawable/circle_bg_primary" />

    <TextView
        android:id="@+id/tv_preview_level"
        android:layout_width="38dp"
        android:layout_height="wrap_content"
        android:text="单词"
        android:textSize="11sp"
        android:textColor="@color/theme_text_secondary"
        android:gravity="center"
        android:layout_marginStart="10dp" />

    <TextView
        android:id="@+id/tv_preview_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="(n.)"
        android:textSize="16sp"
        android:textColor="@color/theme_text_primary"
        android:textStyle="bold"
        android:layout_marginStart="10dp"
        android:maxLines="2"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/tv_preview_audio"
        android:layout_width="32dp"
        android:layout_height="wrap_content"
        android:text="⏳"
        android:textSize="14sp"
        android:gravity="center" />
</LinearLayout>
