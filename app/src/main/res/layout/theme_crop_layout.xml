<?xml version="1.0" encoding="utf-8"?>
<!-- 自建裁剪页（CanHub CropImageView）：
     顶部工具栏 + 裁剪视图（下层为高斯模糊背景图，裁剪框外优雅呈现模糊图像）+
     圆形 Tab 行（滑动/点击切换属性）+ 滚轮式微调控件（iOS 裁剪页风格） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:orientation="vertical">

    <!-- 顶部工具栏（marginTop 留出安全间距，避免贴顶误触） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <TextView
            android:id="@+id/btn_crop_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:text="取消"
            android:textColor="@android:color/white"
            android:textSize="15sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btn_crop_auto_fit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp"
            android:paddingVertical="10dp"
            android:text="自动适配"
            android:textColor="@android:color/white"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btn_rotate_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp"
            android:paddingVertical="10dp"
            android:text="左旋"
            android:textColor="#99FFFFFF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btn_rotate_right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp"
            android:paddingVertical="10dp"
            android:text="右旋"
            android:textColor="#99FFFFFF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btn_flip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp"
            android:paddingVertical="10dp"
            android:text="翻转"
            android:textColor="#99FFFFFF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btn_crop_done"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:text="完成"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 裁剪区域（左右留白 24dp：避免拖动靠近屏幕边缘的裁剪句柄时误触发系统返回手势） -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="24dp"
        android:layout_weight="1"
        android:background="@android:color/black">

        <!-- 裁剪视图（背景透明；框外遮罩由 CropImageOptions.backgroundColor 提供） -->
        <com.canhub.cropper.CropImageView
            android:id="@+id/crop_image_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent" />
    </FrameLayout>

    <!-- 圆形 Tab 行（滑动/点击切换：旋转 / 缩放 / 比例） -->
    <com.deepsleep.memory.ui.components.CircularTabsView
        android:id="@+id/circular_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp" />

    <!-- 滚轮式微调控件（横向刻度滚轮） -->
    <com.deepsleep.memory.ui.components.WheelSliderView
        android:id="@+id/wheel_slider"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_marginTop="8dp" />

    <!-- 底部安全间距（防误触全面屏手势） -->
    <View
        android:layout_width="match_parent"
        android:layout_height="20dp" />
</LinearLayout>
