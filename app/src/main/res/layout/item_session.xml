<?xml version="1.0" encoding="utf-8"?>
<!-- 会话列表项：替代原先的 android.R.layout.simple_list_item_2
     （系统布局的文字色不跟随明暗主题，暗色模式下不可读） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="2dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_session_item"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="11dp"
    android:paddingBottom="11dp">

    <ImageView
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@drawable/bg_session_icon"
        android:padding="8dp"
        android:src="@drawable/ic_forum_24"
        android:tint="@color/theme_primary"
        android:scaleType="fitCenter"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvSessionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/theme_text_primary" />

        <TextView
            android:id="@+id/tvSessionTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:maxLines="1"
            android:textSize="12sp"
            android:textColor="@color/theme_text_secondary" />
    </LinearLayout>

</LinearLayout>
