<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">

    <!-- ═══ 标题栏（固定在 ScrollView 之外，与主设置界面结构一致，阴影不被裁剪）═══ -->
    <LinearLayout
        android:id="@+id/ai_provider_title_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/white"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="12dp"
        android:gravity="center_vertical"
        android:elevation="4dp">

        <ImageButton
            android:id="@+id/ai_provider_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/back"
            android:padding="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="AI服务配置"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="@color/theme_text_primary" />

        <View
            android:layout_width="44dp"
            android:layout_height="44dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/white"
            android:paddingBottom="32dp">



        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="24dp"
            android:text="API Key 只会加密后保存在服务端，不会显示在客户端。"
            android:textColor="@color/theme_text_secondary" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/light_gray"
            app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Provider 名称" app:boxStrokeColor="@color/theme_primary">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/ai_provider_name" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="协议" app:boxStrokeColor="@color/theme_primary">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/ai_provider_protocol" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapCharacters" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Base URL" app:boxStrokeColor="@color/theme_primary">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/ai_provider_base_url" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textUri" />
                </com.google.android.material.textfield.TextInputLayout>
                <Spinner android:id="@+id/ai_provider_model" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/rounded_spinner_dropdown" android:spinnerMode="dropdown" />
                <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="自定义模型名（可选）" app:boxStrokeColor="@color/theme_primary">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/ai_provider_model_custom" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="API Key" app:boxStrokeColor="@color/theme_primary" app:endIconMode="password_toggle">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/ai_provider_key" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/ai_provider_consent" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:buttonTint="@color/theme_primary" android:text="我同意将 AI 任务数据发送给该 Provider" />
                <com.google.android.material.button.MaterialButton android:id="@+id/ai_provider_save" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="验证并保存" android:textColor="@color/theme_on_primary" app:backgroundTint="@color/theme_primary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/light_gray"
            app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="按任务选择模型" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/theme_text_primary" />
                <Spinner android:id="@+id/ai_task_type" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/rounded_spinner_dropdown" android:spinnerMode="dropdown" />
                <Spinner android:id="@+id/ai_task_primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/rounded_spinner_dropdown" android:spinnerMode="dropdown" />
                <Spinner android:id="@+id/ai_task_fallback" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/rounded_spinner_dropdown" android:spinnerMode="dropdown" />
                <com.google.android.material.button.MaterialButton android:id="@+id/ai_task_route_save" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="保存任务路由" android:textColor="@color/theme_primary" style="@style/Widget.Material3.Button.TonalButton" app:backgroundTint="@color/item_background_stress" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView android:id="@+id/ai_provider_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_marginTop="12dp" android:layout_marginEnd="16dp" android:textColor="@color/theme_text_secondary" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
