            android:fullBackupContent="@xml/backup_rules"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:networkSecurityConfig="@xml/network_security_config"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:supportsRtl="true"
            android:theme="@style/Theme.Memory"
            tools:targetApi="31">
        <activity
                android:name=".ui.treasure_view.pronunciation_view.PronunciationReportActivity"
                android:exported="false"/>
        <activity
                android:name=".ui.treasure_view.pronunciation_view.PronunciationMinuteFollowActivity"
                android:exported="false"/>        <!-- 学情分析模块 -->
        <activity
                android:name=".ui.treasure_view.evaluation_view.EvaluationActivity"
                android:exported="false"
                android:screenOrientation="portrait"/>
        <activity
                android:name=".ui.treasure_view.evaluation_view.EvaluationDashboardActivity"
                android:exported="false"
                android:screenOrientation="portrait"/>
        <activity
                android:name=".ui.treasure_view.evaluation_view.EvaluationTrendActivity"
                android:exported="false"
                android:screenOrientation="portrait"/>
        <activity
                android:name=".ui.treasure_view.evaluation_view.EvaluationWeeklyReportActivity"
                android:exported="false"
                android:screenOrientation="portrait"/>
        <activity
                android:name=".ui.treasure_view.evaluation_view.EvaluationAiSuggestionActivity"
                android:exported="false"
                android:screenOrientation="portrait"/>
        <activity
                android:name=".ui.treasure_view.evaluation_view.EvaluationDeepAnalysisActivity"
